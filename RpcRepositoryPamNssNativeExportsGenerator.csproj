<Project>
	<PropertyGroup>
    	<!-- Source Generator. -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>

		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>

		<RootNamespace>RpcScandinavia.Repository.PamNss.SourceGenerator</RootNamespace>
		<PackageId>RpcRepositoryPamNssNativeExportsGenerator</PackageId>

		<!--
		<BaseOutputPath>bin-generator\</BaseOutputPath>
		<MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
		-->

		<!-- Move the "bin" folder. -->
		<OutDir>bin-generator/</OutDir>
		<OutputPath>$(OutDir)</OutputPath>

		<!-- Move the "obj" folder. -->
		<BaseIntermediateOutputPath>obj-generator/</BaseIntermediateOutputPath>
	</PropertyGroup>

	<!-- Import SDK properties here, when moving the "obj" folder. -->
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

	<ItemGroup>
		<!-- Only use files in the "NativeExportsGenerator" directory. -->
		<Content Remove="**" />
		<Compile Remove="**" />
		<Compile Include="NativeExportsGenerator/**" />

		<!-- Package References: Roselyn. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" PrivateAssets="all" />
	</ItemGroup>

	<!-- Import SDK targets last, when moving the "obj" folder. -->
	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
